<?xml version="1.0"?>

<robot name="TQBot2" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:arg name="DEBUG" default="false"/>
    <xacro:arg name="gpu" default="true"/>
    <xacro:arg name="SELF_COLLISION" default="false"/>
    <xacro:property name="gpu" value="$(arg gpu)" />
    <xacro:property name="self_collision_enabled" value="$(arg SELF_COLLISION)" />
    <xacro:property name="self_collision_value"
                    value="${1 if self_collision_enabled else 0}" />

    <xacro:include filename="$(find TQBot2_description)/xacro/const.xacro"/>
    <xacro:include filename="$(find TQBot2_description)/xacro/materials.xacro"/>
    <xacro:include filename="$(find TQBot2_description)/xacro/leg.xacro"/>
    <!-- <xacro:include filename="$(find TQBot2_description)/xacro/stairs.xacro"/> -->
    <xacro:include filename="$(find TQBot2_description)/xacro/gazebo.xacro"/>
    <!-- <xacro:include filename="$(find TQBot2_description)/xacro/depthCamera.xacro"/>
    <xacro:include filename="$(find TQBot2_description)/xacro/ultraSound.xacro"/> -->
    <!-- <xacro:include filename="$(find TQBot2_gazebo)/launch/stairs.urdf.xacro"/> -->

    <!-- VLP16 激光雷达 -->
    <!-- <xacro:include filename="$(find TQBot2_description)/xacro/VLP-16.urdf.xacro"/>
    <xacro:VLP-16 parent="trunk" name="velodyne" topic="/points_raw" hz="10" lasers="16" samples="1875" min_range="0.3" max_range="130.0" gpu="${gpu}">
        <origin xyz="0 0 ${trunk_height/2}" rpy="0 0 0" />
