    <!-- VLP16 模型但是32线雷达数据 -->
    <!-- <xacro:include filename="$(find TQBot2_description)/xacro/VLP-16-32.urdf.xacro"/>
    <xacro:VLP-16 parent="trunk" name="velodyne" topic="/points_raw" hz="10" lasers="32" samples="2187" min_range="0.5" max_range="130.0" gpu="${gpu}">
